{
  "manifest_version": 3,
  "name": "BiliShelf 哔哩收藏架",
  "version": "0.5.9",
  "description": "B站收藏夹管理扩展：侧边栏浏览、缓存同步、多条件排序、悬停浮窗预览、导出备份、回收站、倍速/播放模式保留、左视频右收藏架布局和快捷取消收藏和侧边栏键盘选片。",
  "action": {
    "default_title": "打开 BiliShelf 哔哩收藏架"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://player.bilibili.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://www.bilibili.com/*",
        "https://space.bilibili.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://space.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://player.bilibili.com/*"
      ],
      "js": [
        "preview-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
